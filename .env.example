# IntelliShield SDN — Release 1.0 environment example
# Copy to .env (do not commit secrets). Scripts will create .env from this
# file if missing, without overwriting an existing .env.
#
# Load manually:
#   set -a; source .env; set +a
# Or export individually before starting controller/dashboard.

# -----------------------------------------------------------------------------
# Ops profile (NEW in Release 1.0)
#   lab | demo | development | dev  → freeze RL confidence gate at 60%
#   production (default)            → adaptive gate clamped ~55–75%
# For thesis/live demos use: lab
# -----------------------------------------------------------------------------
INTELLISHIELD_OPS_PROFILE=lab

# -----------------------------------------------------------------------------
# Collaborative fusion (R6) — default ON
# Set to 0 to force legacy entropy/ML dual-path without fusion
# -----------------------------------------------------------------------------
INTELLISHIELD_R6_FUSION=1

# -----------------------------------------------------------------------------
# Dashboard Mininet control (lab only) — leave empty if using sudoers NOPASSWD
# Prefer: sudoers entry for traffic_scheduler instead of storing a password
# -----------------------------------------------------------------------------
INTELLISHIELD_SUDO_PASS=sojwal2004

# -----------------------------------------------------------------------------
# Demo-only: auto-train synthetic ML models if missing (default off)
# -----------------------------------------------------------------------------
INTELLISHIELD_AUTO_TRAIN_SYNTHETIC=0

# -----------------------------------------------------------------------------
# Python import path — must include repository root
# Update scripts set this automatically when sourcing the venv helper.
# -----------------------------------------------------------------------------
# PYTHONPATH=

# -----------------------------------------------------------------------------
# Not used by Release 1.0 core (documenting absence)
#   REDIS_URL, DATABASE_URL, POSTGRES_*  — Not implemented
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Phase 8 — Authentication & Identity Foundation (dashboard)
# Observational SOC GETs remain public. Auth protects future control boundaries.
# Never commit real secrets. Generate a password hash with:
#   python3 -c "from dashboard.auth.passwords import hash_password; print(hash_password('YOUR_PASSWORD'))"
# -----------------------------------------------------------------------------
# INTELLISHIELD_AUTH_ENABLED=1
# INTELLISHIELD_AUTH_SECRET_KEY=replace-with-long-random-string
# INTELLISHIELD_AUTH_USERNAME=operator
# INTELLISHIELD_AUTH_PASSWORD_HASH=pbkdf2_sha256$210000$...
# INTELLISHIELD_AUTH_SESSION_TTL_SECONDS=28800
# INTELLISHIELD_AUTH_COOKIE_SECURE=0
# INTELLISHIELD_AUTH_COOKIE_SAMESITE=lax
# INTELLISHIELD_AUTH_LOGIN_MAX_ATTEMPTS=10
# INTELLISHIELD_AUTH_LOGIN_WINDOW_SECONDS=300
# Server-assigned roles for the configured credential (comma-separated).
# Valid: VIEWER, ANALYST, OPERATOR, ADMIN. Default: VIEWER (least privilege).
# Client-supplied roles are never trusted. Future ops permissions remain NOT ENABLED.
# For Command Center dry-run, use ANALYST (grants INVESTIGATE_EVENTS):
# INTELLISHIELD_AUTH_ROLES=ANALYST
# -----------------------------------------------------------------------------
# Phase 11 — Durable operator command / audit / idempotency store (SQLite)
# Scoped to SOC command-safety infrastructure only. Execution remains DISABLED.
# Default path: logs/operator/command_store.db
# -----------------------------------------------------------------------------
# INTELLISHIELD_COMMAND_DB_PATH=/absolute/path/to/command_store.db
# Freshness for HIGH/CRITICAL commands — unset = fail closed for high-risk
# INTELLISHIELD_COMMAND_FRESHNESS_MAX_AGE_SECONDS=300

# -----------------------------------------------------------------------------
# Email Alert Notifications — confirmed-attack email alerts via Gmail SMTP
# Uses Google App Password (not normal Gmail password).
# Generate one at: https://myaccount.google.com/apppasswords
# Emails are triggered by confirmed attacks from R6 Fusion → R7 Verification.
# -----------------------------------------------------------------------------
ALERT_EMAIL_ENABLED=true
ALERT_EMAIL_TO=sojupingale@gmail.com
ALERT_SMTP_HOST=smtp.gmail.com
ALERT_SMTP_PORT=587
ALERT_SMTP_USER=sojupingale@gmail.com
ALERT_SMTP_PASSWORD=jmrq iddp vxof qjsj
ALERT_EMAIL_COOLDOWN_SECONDS=300
# Optional: send recovery notification when attack ends
# ALERT_EMAIL_RECOVERY=false
# for trsting emails = python -m pytest tests/test_email_alerts.py -v

    